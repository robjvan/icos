#!/bin/sh
# Local claims verifier (optional). Serves a Jev-style decision model for
# the M15.5 hallucination check.
#
# macOS: MLX on the HOST — Docker Desktop cannot reach Apple's GPU, so a
# container would be CPU-only and slow. Serves http://127.0.0.1:8765 and
# core (in Docker) reaches it at http://host.docker.internal:8765.
#
# Linux: would become a CUDA compose service (future work); this helper
# still runs it in-process (PyTorch, CUDA or CPU) for now.
#
# Jev-style needs Python >= 3.10. `uv` is preferred (it can fetch a managed
# Python); a modern system python3 works too.
#
# Usage: bin/verifier [extra jev-style serve args...]
#   JEV_STYLE_RELEASE=0.8b bin/verifier    # smaller/faster model
#   JEV_PRECISION=bf16 bin/verifier        # closest-to-FP32 MLX (3.76 GB)
set -e
cd "$(dirname "$0")/.."

VENV="${HOME}/.icos/verifier/venv"
PYTHON_VERSION="${JEV_PYTHON:-3.12}"

case "$(uname -s)" in
  Darwin) EXTRA="mlx" ;;
  *) EXTRA="torch" ;;
esac

find_uv() {
  if command -v uv >/dev/null 2>&1; then
    command -v uv
    return
  fi
  for candidate in "${HOME}/.local/bin/uv" "${HOME}"/Library/Python/*/bin/uv; do
    if [ -x "${candidate}" ]; then
      echo "${candidate}"
      return
    fi
  done
}

have_modern_python() {
  command -v python3 >/dev/null 2>&1 || return 1
  python3 -c 'import sys; sys.exit(0 if sys.version_info >= (3, 10) else 1)'
}

if [ ! -x "${VENV}/bin/jev-style" ]; then
  UV="$(find_uv)"
  echo "bin/verifier: setting up the Jev runtime in ${VENV} (one time)..."
  rm -rf "${VENV}"
  mkdir -p "$(dirname "${VENV}")"
  if [ -n "${UV}" ]; then
    "${UV}" venv --python "${PYTHON_VERSION}" "${VENV}"
    "${UV}" pip install --python "${VENV}/bin/python" "jev-style[${EXTRA}]"
  elif have_modern_python; then
    python3 -m venv "${VENV}"
    "${VENV}/bin/pip" install --upgrade pip
    "${VENV}/bin/pip" install "jev-style[${EXTRA}]"
  else
    echo "bin/verifier: need 'uv' (recommended) or python3 >= 3.10." >&2
    echo "  Install uv:  curl -LsSf https://astral.sh/uv/install.sh | sh" >&2
    exit 1
  fi
fi

# Default to the 2B decision model; override with JEV_STYLE_RELEASE.
JEV_STYLE_RELEASE="${JEV_STYLE_RELEASE:-2b}"
export JEV_STYLE_RELEASE

JEV_PRECISION="${JEV_PRECISION:-8bit}"
export JEV_PRECISION

echo "bin/verifier: serving http://127.0.0.1:8765 (release ${JEV_STYLE_RELEASE}, ${JEV_PRECISION})."
echo "bin/verifier: core in Docker reaches it at http://host.docker.internal:8765"
echo "bin/verifier: set HALLUCINATION_DECISION_URL=http://host.docker.internal:8765"

exec "${VENV}/bin/jev-style" serve --precision "${JEV_PRECISION}" "$@"
