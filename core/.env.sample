PORT=3000
# Interface to bind. Default 127.0.0.1 (this machine only). Set 0.0.0.0
# only to expose deliberately — read "Security" in the README first.
# In Docker the app must bind 0.0.0.0; the boundary is then the published
# port (docker-compose publishes to 127.0.0.1 by default).
HOST=127.0.0.1
# Browser origins allowed to call the API (comma-separated, exact
# scheme://host:port). Defaults to the bundled local web client. "*" is
# refused — wildcard access is unsafe. Add your real origin(s) here when
# serving a frontend from another host.
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
# Set true ONLY once TLS + authentication are in front of a deliberately
# exposed (non-loopback) instance. It silences the off-loopback boot
# warning; it changes no behavior.
EXPOSE_ACKNOWLEDGED=false

# API authentication (S2). On by default: every route needs a session
# except /core/auth/* and /core/health/live. The bootstrap token is
# generated on first run at AUTH_DIR_PATH/token (0600) — read it there
# and use it to log in; it is never logged. Session cookies are
# HMAC-signed and httpOnly; a CSRF cookie enables double-submit checks
# on mutations. Failed logins are rate-limited per IP.
AUTH_ENABLED=true
# Directory holding the bootstrap token, session key, and audit log.
AUTH_DIR_PATH=~/.icos/auth
# Session lifetime in ms (default 30 days).
AUTH_SESSION_TTL_MS=2592000000
# Secure session cookie. Requires HTTPS — keep true. Set false ONLY for
# trusted loopback/LAN HTTP development.
AUTH_COOKIE_SECURE=true

# Secret vault (S3). Values written through the API (for MCP servers, LLM
# providers, …) are encrypted here with AES-256-GCM; the catalog holds
# references (`secret:NAME`), never values. The master key is 32 bytes as
# hex/base64, supplied via a file (preferred, e.g. a Docker secret) or the
# environment. No key = vault disabled (env `$VAR` references still work);
# a non-empty vault with no key fails boot. Back the key up separately —
# the vault is useless without it.
# VAULT_PATH=~/.icos/auth/secrets.vault   # default <AUTH_DIR_PATH>/secrets.vault
# VAULT_KEY_FILE=/run/secrets/icos_vault_key
# VAULT_KEY=

# LLM provider catalog (S4). When this file exists, the provider selected
# in its "active" map replaces the LLM_* / MEMORY_LLM_* endpoint values
# below. Entries are { id, baseUrl, model, apiKeyRef?, headers?, userAgent?,
# timeoutMs?, enabled? }; apiKeyRef and header values are references
# ($VAR or secret:NAME), never literals. Absent file = env-only, as before.
# PROVIDERS_PATH=~/.icos/providers.json

# Provider id: ollama, llama.cpp, openrouter, opencode, ... Plain label
# except for one behavior: ids in the opencode family ("opencode",
# "opencode-zen", ...) attach the x-opencode-session affinity header
# using the ICOS session id.
LLM_PROVIDER=ollama
# Required: model name served by your OpenAI-compatible endpoint.
# Passed through unchanged — no model registry in Core.
LLM_MODEL=
# Base URL of the OpenAI-compatible API. Trailing slash optional.
#   Ollama:     http://localhost:11434/v1
#   llama.cpp:  http://localhost:8080/v1
#   OpenRouter: https://openrouter.ai/api/v1
#   OpenCode:   https://opencode.ai/zen/go/v1   (Go/Zen gateway)
LLM_BASE_URL=http://localhost:11434/v1
# Optional bearer key. Leave empty for local endpoints like Ollama.
# Never logged, never returned by the API, never persisted.
LLM_API_KEY=
# Optional static headers as a JSON object, merged into every request
# (e.g. OpenRouter attribution). Explicit values win over derived ones.
LLM_HEADERS=
# Optional User-Agent. Default: icos/<core version>. OpenCode asks
# clients to identify with their own agent rather than a generic one.
LLM_USER_AGENT=
# Per-request timeout in ms.
LLM_TIMEOUT_MS=60000
# M16.2d: whether the conversation model accepts image input. True (default)
# inlines image attachments into the turn. Set false for a text-only model:
# images are then routed through the auxiliary vision role (VISION_LLM_*) as
# a text description instead.
LLM_VISION_ENABLED=true
# System prompt used for context construction.
SYSTEM_PROMPT=You are ICOS, a helpful assistant.
# Context-construction limit: how many recent messages reach the LLM.
# The transcript database keeps everything; this only bounds context.
MAX_HISTORY=50
# SQLite transcript database (sessions + messages + FTS). Split from the
# memory-candidate ledger; parent directories are created automatically.
SESSION_DB_PATH=~/.icos/data/sessions.db
# Memory-candidate evidence ledger. Cross-database provenance is by
# convention (plain columns), not foreign keys.
MEMORY_DB_PATH=~/.icos/data/memories.db
# Curated persona model (M14): identity/self records, user facts,
# relationship state, staged candidates, and the drift log. Deliberately
# a separate file from the memory stores so identity is never touched by
# memory writes or by memory-store tampering.
PERSONA_DB_PATH=~/.icos/data/persona.db
# External channel store (M16): the unified inbound/outbound message ledger
# and the durable outbound delivery queue. Its own file, like persona.
CHANNELS_DB_PATH=~/.icos/data/channels.db
# Outbound channel delivery (M16b): cadence, batch, retry cap, and backoff
# for the durable delivery queue. The loop runs only when a channel adapter
# is enabled. Defaults shown; uncomment to override.
# CHANNEL_DELIVERY_ENABLED=true
# CHANNEL_DELIVERY_INTERVAL_MS=5000
# CHANNEL_DELIVERY_BATCH=10
# CHANNEL_DELIVERY_MAX_ATTEMPTS=5
# CHANNEL_DELIVERY_BACKOFF_BASE_MS=1000
# CHANNEL_DELIVERY_BACKOFF_CAP_MS=30000
# CHANNEL_SEND_MIN_INTERVAL_MS=250
# Discord channel (M16c). Bot token: a literal value, or a secret reference
# (`$VAR` / `secret:NAME`) settable — never viewable — from the web
# Server-settings vault. Leave empty to disable the channel. Bot needs the
# intents: Guilds, GuildMessages, MessageContent, DirectMessages.
# DISCORD_BOT_TOKEN=
# Inbound policy (M16d): a guild channel is a chat channel when its topic
# contains "[icos-stream: chat]" (override the marker with
# DISCORD_STREAM_MARKER), or when its id is listed in
# DISCORD_ALLOWED_CHANNEL_IDS. A non-empty DISCORD_ALLOWED_USER_IDS restricts
# who may be answered. DMs are answered unless DISCORD_ALLOW_DMS=false.
# DISCORD_STREAM_MARKER=[icos-stream:
# DISCORD_ALLOWED_CHANNEL_IDS=
# DISCORD_ALLOWED_USER_IDS=
# DISCORD_ALLOWED_GUILD_IDS=
# DISCORD_ALLOW_DMS=true
# Presence (M16m): announce the runtime lifecycle in a status channel — a
# channel whose topic contains "[icos-stream: status]", or the id in
# DISCORD_STATUS_CHANNEL_ID. Unset → no announcement (a normal state).
# Set DISCORD_PRESENCE_ENABLED=false to silence it. Online goes through the
# durable queue (retried); offline is a best-effort direct send on graceful
# shutdown (a hard kill sends nothing).
# DISCORD_PRESENCE_ENABLED=true
# DISCORD_STATUS_CHANNEL_ID=
# DISCORD_PRESENCE_ONLINE=♻️ Gateway online — ICOS is back and ready.
# DISCORD_PRESENCE_OFFLINE=⚠️ Gateway shutting down — the current task may be interrupted.
# Email channel (M16.1, Brevo transactional API). Outbound-only for now; a
# missing API key or sender leaves the channel disabled (never fatal). The key
# is a literal or a secret reference ($VAR / secret:NAME), settable — never
# viewable — from the web Server-settings vault. EMAIL_ALLOWED_RECIPIENTS
# constrains agent-initiated (channel.send) email; the first entry is the
# operator. BREVO_API_BASE_URL is overridable for tests.
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=
# BREVO_SENDER_NAME=
# EMAIL_ALLOWED_RECIPIENTS=
# EMAIL_DEFAULT_SUBJECT=ICOS
# BREVO_API_BASE_URL=https://api.brevo.com/v3
# Web attachments (M16.2). Uploaded files are stored owner-only under this
# directory (host-absolute under the data root). Size is capped and content
# types are restricted to the allow-list (comma-separated).
# ATTACHMENTS_DIR_PATH=~/.icos/data/attachments
# ATTACHMENTS_MAX_BYTES=10485760
# ATTACHMENTS_ALLOWED_MIME_TYPES=image/png,image/jpeg,image/gif,image/webp,application/pdf,text/plain,text/markdown,application/json
# Immutable core persona (M14): the human-authored file that defines an
# ICOS agent (ethical grounding, core beliefs, safety boundaries,
# non-negotiables, agentic character). Read-only at runtime — ICOS has no
# write path to it; changing it is a human act, recorded on next boot.
# A missing/invalid file degrades grounding loudly rather than inventing
# an identity. For the strongest isolation, bind this directory read-only
# into the container. Start from `core/persona/core.example.md`.
PERSONA_CORE_PATH=~/.icos/persona/core.md
# Fail closed if the core is missing/invalid: ICOS refuses to start rather
# than run half-grounded (drift and hallucination checks need a reference).
# Set false only for dev/throwaway instances. Default: true.
PERSONA_CORE_REQUIRED=true
# Seed import root (M14c): the only directory persona seed imports may read
# from. Relative `.md` paths only; realpath-confined; imports are idempotent
# and never overwrite curated records (they stage a candidate instead).
PERSONA_SEED_ROOT=~/.icos/seeds
# Grounding band caps (M14d): the persona band injected at session start.
# The core is always included first; evolving entries fill under these caps.
PERSONA_GROUNDING_ENTRY_LIMIT=12
PERSONA_GROUNDING_CHARACTER_BUDGET=6000
# Drift detection thresholds (M15b). Findings are de-duplicated while
# unresolved and cleared when the condition no longer holds.
PERSONA_RELATIONSHIP_FRESH_HOURS=48
PERSONA_GROUNDING_WARMUP_THRESHOLD=0.6
PERSONA_CANDIDATE_PRESSURE_COUNT=3
PERSONA_CANDIDATE_PRESSURE_SIMILARITY=0.6
# Semantic drift (M15c): the token-distribution triad + baselines, with
# the real embedding model (RuVector) when it loads. Signals at/above the
# floor are logged; at/above the critical floor severity escalates.
# The floor is calibrated to the M15e corpus (best embedding F1 at 0.20)
# and is provisional — semantic drift is advisory, and subtle value /
# commitment changes need proposition-level checks (M15.5).
PERSONA_SEMANTIC_DRIFT_FLOOR=0.2
PERSONA_SEMANTIC_CRITICAL_FLOOR=0.5
# Cumulative drift (M15d): consecutive elevated review cycles that flag a
# persistent direction change (severity `cumulative`, above critical).
PERSONA_CUMULATIVE_MIN_CYCLES=3

# Secondary-model verification (M15.5c). Preferred tier first:
# - a systemone decision model (local Jev or any Jev-compatible server);
# - else an OpenAI-compatible LLM verifier (a catalog provider id);
# - neither set = deterministic claim/evidence checks only.
# The verifier tier and its independence (independent vs self) are recorded
# with every verdict.
# Claims verifier: a systemone decision endpoint. On macOS run `bin/verifier`
# on the host (Docker cannot reach the Apple GPU); core in Docker reaches it
# at host.docker.internal. On Linux this becomes a verifier service
# (http://verifier:8765) — future work. Leave unset for deterministic-only.
HALLUCINATION_DECISION_URL=http://host.docker.internal:8765
# Optional bearer reference ($VAR or secret:NAME) for the decision endpoint.
HALLUCINATION_DECISION_API_KEY_REF=
# A provider id from providers.json (see the models tab). The fallback
# verifier is expected to be the already-loaded local model (gemma4) in a
# different role; if it is the same model that spoke, the verdict is
# recorded as `self`, not independent.
HALLUCINATION_VERIFIER_PROVIDER=
HALLUCINATION_VERIFIER_TIMEOUT_MS=10000
# Mitigation posture (M15.5d): what ICOS does with a finding, per severity.
# Strategies: none | flag | re_ground | defer | refuse. Conservative
# defaults: critical -> refuse, warning/watch -> flag, info -> none.
# `re_ground` is executed at turn time (retrieve and re-answer); this layer
# decides and logs, never rewrites silently.
HALLUCINATION_MITIGATE_INFO=none
HALLUCINATION_MITIGATE_WATCH=flag
HALLUCINATION_MITIGATE_WARNING=flag
HALLUCINATION_MITIGATE_CRITICAL=refuse
# Deprecated pre-split database. Probed once as a read-only migration
# source when the split files do not exist yet; never written to.
CORE_DB_PATH=./data/core.sqlite

# Memory candidate extraction (Milestone 4). Runs after each completed turn
# against a separate model role. Each MEMORY_* falls back to its LLM_*
# counterpart when unset, so extraction works with zero extra config.
MEMORY_EXTRACTION_ENABLED=true
MEMORY_PROVIDER=
MEMORY_LLM_BASE_URL=http://localhost:11434/v1
MEMORY_LLM_MODEL=
MEMORY_LLM_API_KEY=
MEMORY_LLM_HEADERS=
MEMORY_LLM_USER_AGENT=
MEMORY_LLM_TIMEOUT_MS=60000

# Vision role (M17b.8). An auxiliary image-capable model that answers the
# `vision_analyze` tool on behalf of a text-only chat model (or as a second
# opinion). Each VISION_* falls back to its MEMORY_* counterpart, then to
# LLM_*, so the local `gemma4:e4b` memory model serves vision with no extra
# config. Inside Docker, point this at the host Ollama via
# host.docker.internal, not localhost.
VISION_PROVIDER=
VISION_LLM_BASE_URL=
VISION_LLM_MODEL=
VISION_LLM_API_KEY=
VISION_LLM_HEADERS=
VISION_LLM_USER_AGENT=
VISION_LLM_TIMEOUT_MS=60000

# Image generation (M17b.9). Provider-agnostic and config-first. Set
# IMAGE_GEN_PROVIDER=openai and IMAGE_GEN_BASE_URL to enable the
# OpenAI-compatible /images/generations backend. IMAGE_GEN_API_KEY may be a
# literal or a `$VAR` / `secret:NAME` reference resolved at call time (vault).
# Unconfigured = the `image_generate` tool reports unavailable (no fake
# success). A ComfyUI backend (workflow-file driven) is a follow-up. Live
# verification is pending (no provider credits / GPU hardware yet).
IMAGE_GEN_PROVIDER=
IMAGE_GEN_BASE_URL=
IMAGE_GEN_MODEL=
IMAGE_GEN_API_KEY=
IMAGE_GEN_TIMEOUT_MS=120000
IMAGE_GEN_OUTPUT_DIR=

# Belief promotion authority (Milestone 10c). False (default): every
# candidate → belief promotion needs a human approval. True admits
# NEW claims of the listed kinds without approval — REINFORCE and
# CONTRADICT always require approval. Flip only with evidence.
MEMORY_PROMOTION_AUTO=false
# Comma-separated candidate kinds, e.g. "fact,observation". Empty
# admits nothing. Unknown kinds fail startup loudly.
MEMORY_PROMOTION_AUTO_KINDS=

# Clarification trigger (Milestone 10e). A contradiction parks a
# prospective_items question when the contradicted belief's
# confidence sits below this threshold. Repeat contests (same
# subject+predicate contradicted twice) park regardless.
MEMORY_PROSPECTIVE_CONFIDENCE_THRESHOLD=0.5

# Recall confidence gate (Milestone 11b). Claims below this engine
# confidence are excluded from recall unless explicitly queried (or
# locked — M12's certainty lock always admits).
MEMORY_RECALL_CONFIDENCE_GATE=0.3
# Interactive recall lens (Milestone 11d). Comma-separated claim
# origins hidden from turn-time recall, e.g. "agent". Empty hides
# nothing (default). Unknown values fail startup. The store is
# untouched — this is a lens, never a deletion.
MEMORY_RECALL_EXCLUDE_ORIGINS=
# Memory band budget (Milestone 11e). Estimated-token cap for the
# recalled-belief band per turn; over-cap bands shrink familiar
# rows first, then demoted, then lowest-fused recalled — never the
# user message. Chars/4 estimate, documented in prompt-bands.ts.
MEMORY_RECALL_MAX_BAND_TOKENS=800
# Recall latency budget in ms (Milestone 11e). A turn-time recall
# exceeding this degrades to bare context instead of stalling the
# turn.
MEMORY_RECALL_TIMEOUT_MS=5000
# Belief maintenance (Milestone 12a). Async reinforcement/linking
# pass on a cadence; never blocks turns. False disables the
# schedule (explicit POST /core/maintenance/run still works).
MEMORY_MAINTENANCE_ENABLED=true
MEMORY_MAINTENANCE_INTERVAL_MS=3600000
# Agent dampening (Milestone 12c). Agent-origin claims compound at
# this fraction of the normal step, so self-echo never inflates
# machine-made beliefs. Conservative default; lower is stricter.
MEMORY_AGENT_DAMPENING=0.5

# MCP servers (Milestones 13a/b). Master kill-switch (default off
# until proven); catalog file with one entry per server (see
# mcp-server-config.ts for the shape); per-call timeout in ms.
# Empty catalog path falls back to ~/.icos/mcp-servers.json.
# Secrets: catalog `env` values must be "$VAR" references resolved
# from the process environment at spawn — never literals. Export
# keys before launch (e.g. BYTESTASH_API_KEY=... ); a missing var
# disables that server loudly instead of spawning it half-secreted.
# Streamable-HTTP servers authenticate the same way via a `headers`
# map of "$VAR" references (e.g. "Authorization": "$BYTESTASH_AUTH"
# with BYTESTASH_AUTH="Bearer <token>" exported before launch).
MCP_ENABLED=false
MCP_SERVERS_PATH=~/.icos/mcp-servers.json
MCP_TIMEOUT_MS=30000
# Background reconnect cadence (ms) for failed servers; 0 disables
# auto-retry (reload / manual reconnect still work).
MCP_RECONNECT_BACKOFF_MS=10000

# Claim vector index (Milestone 10d). Embedded RuVector store for the
# semantic recall surface; SQLite stays the system of record. The
# embedding model (~90MB, one download) caches under RUVECTOR_CACHE_DIR.
VECTOR_DB_PATH=~/.icos/data/claims-vector.db
# Embedding model cache. Keep inside the shared data root
# (/Users/rob/.icos, bind-mounted by docker-compose) so the model
# survives container rebuilds.
RUVECTOR_CACHE_DIR=~/.icos/models

# Skills catalog (Milestone 7). Filesystem-backed procedural knowledge:
# one <name>/SKILL.md per skill, optionally nested under a category dir
# (M18: <category>/<name>/SKILL.md). Prompt-level only.
# M18.2: the catalog is a CHILD OF THE WORKSPACE by default, so the file and
# terminal tools can read and run a skill's supporting scripts/templates.
SKILLS_DIR_PATH=~/.icos/workspace/skills
# Kill-switch: false restores pre-M7 behavior exactly (no scan, no catalog
# block, no discovery; /skills reports disabled).
SKILLS_ENABLED=true
# M18.1 seed: on startup copy the shipped collection into SKILLS_DIR_PATH,
# never overwriting an existing file (user edits win; delete a skill to
# re-seed it). SKILLS_SEED_ROOT overrides the source (default: the app's
# own skills/ dir, baked into the image).
SKILLS_SEED_ENABLED=true
SKILLS_SEED_ROOT=
# Per-skill body cap in chars (after trimming). Oversize skills are skipped.
SKILLS_MAX_BODY_CHARS=12000
# Cap on catalog summaries injected into model context.
SKILLS_MAX_CATALOG_ITEMS=50
# Cap on explicitly session-pinned skills (/skills use).
SKILLS_MAX_ACTIVE_PER_SESSION=5
# Cap on automatically loaded skills per turn (provisional, M7c).
SKILLS_MAX_AUTO_LOADED_PER_TURN=2
# Cap on total skill-body chars injected per turn (provisional, M7c).
SKILLS_MAX_CONTEXT_CHARS=8000

# Agent execution budgets (Milestone 9g). Bounds every turn loop and
# post-approval continuation; exhaustion forces a text answer with a
# truthful budget_exhausted terminal state, never silent truncation.
# Max proposal rounds per turn.
AGENT_MAX_ITERATIONS=5
# Max tool executions per turn.
AGENT_MAX_TOOL_STEPS=5
# Backstop turn duration in ms (per-call LLM timeouts bound healthy turns).
AGENT_MAX_TURN_DURATION_MS=900000

# Tool enablement (M17a). Each tool carries a toolset (session, channel, mcp,
# ...). Empty everywhere = every tool is offered (opt-out).
# TOOLS_ENABLED_TOOLSETS is opt-in: when set, only those toolsets are offered.
# TOOLS_DISABLED_TOOLSETS always wins; TOOLS_ENABLED re-enables one tool
# inside a disabled toolset. Disabled tools are declared to the model, never
# silently dropped.
#
# MCP (M19): each connected server generates a `mcp-<server>` toolset from its
# discovered tools (e.g. `mcp-bytestash`). The bare server name is an alias for
# that toolset, and `mcp` aliases every generated toolset. Aliases compose with
# built-in names: a server named `browser` yields both the built-in `browser`
# toolset and `mcp-browser` — use these selectors to scope them.
# TOOLS_ENABLED_TOOLSETS=
# TOOLS_DISABLED_TOOLSETS=
# TOOLS_ENABLED=
# TOOLS_DISABLED=
# Filesystem root the file tools (read_file, search_files, ...) may touch.
# A path resolving outside this root is refused.
# TOOLS_WORKSPACE_ROOT=~/.icos/workspace
# Web search via a self-hosted SearXNG instance (M17b). No API key. The
# instance must expose the JSON format (settings.yml: search.formats should
# include json). From the core container use the host's LAN address, not
# localhost. Unset leaves web_search unavailable.
# SEARXNG_BASE_URL=

# Realtime transport (server-pushed events on /core/events, same port).
# Kill-switch: false selects the noop publisher and never attaches the
# socket — clients fall back to polling, unchanged. Default on: this only
# notifies, unlike MEMORY_PROMOTION_AUTO which mutates state.
REALTIME_ENABLED=true
# Server heartbeat cadence in ms for socket liveness frames.
REALTIME_HEARTBEAT_MS=30000
# Socket origin allowlist, comma-separated. Defaults to
# CORS_ALLOWED_ORIGINS when unset. "*" is refused. A socket with no
# Origin header is rejected.
REALTIME_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
VAULT_KEY_FILE=